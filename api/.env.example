APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
# POCOR-9509: SMTP connection timeout in seconds. Prevents PHP-FPM workers from hanging
# indefinitely when the mail server is unreachable. Set higher if your SMTP is slow.
MAIL_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# -------------------------------------------------------------------------
# POCOR-9509: Alert Scheduler Configuration
# -------------------------------------------------------------------------

# Timezone fallback used only when the database is unavailable (e.g. during migrations).
# At runtime the timezone is automatically read from config_items.code='time_zone' in the DB,
# so this value is overridden by whatever the admin has set in the System > Configuration UI.
# APP_TIMEZONE=UTC

# alerts:check — scans alert rules and fills alert_queue for scheduled alert types
# (RetirementWarning, StaffEmployment, StaffLeave, StaffType, SystemUpdates, etc.)
# ALERT_CHECK_DAILY=true  → runs once daily at ALERT_CHECK_DAILY_TIME (recommended for production)
# ALERT_CHECK_DAILY=false → runs every hour (useful for UAT / testing)
ALERT_CHECK_DAILY=true
ALERT_CHECK_DAILY_TIME=02:00

# alerts:send — dispatches everything pending in alert_queue (email / SMS)
# Event-based alerts (attendance, admission, enrolment) land in alert_queue immediately,
# so alerts:send must run frequently to avoid long delivery delays.
# ALERT_SEND_DAILY=false → runs every 2 minutes (default — recommended for most deployments)
# ALERT_SEND_DAILY=true  → runs once daily at ALERT_SEND_DAILY_TIME (batch mode)
ALERT_SEND_DAILY=false
ALERT_SEND_DAILY_TIME=07:00

# Maximum number of alert_queue rows processed per alerts:send run.
# ALERT_SEND_LIMIT=50  → process up to 50 per run (safe default)
# ALERT_SEND_LIMIT=0   → no limit — send all pending in one run (use with caution on large queues)
ALERT_SEND_LIMIT=50
